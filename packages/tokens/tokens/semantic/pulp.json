{
  "$description": "pulp semantic layer. Names describe a role, values point at primitives. Colours carry a dark counterpart in $extensions; the build emits light-dark().",
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.neutral.50}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.975}"
          }
        },
        "$description": "The page itself: the ground everything else sits on, and table headers."
      },
      "raised": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.900}"
          }
        },
        "$description": "One step up from the page: cards, fields, list and calendar panels. The default fill of a control."
      },
      "overlay": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.875}"
          }
        },
        "$description": "What floats above the page: dialogs, sheets, popovers, menus. One step lighter than raised in dark schemes, where a shadow alone does not separate a menu from a card; in light it may equal raised."
      },
      "sunken": {
        "$value": "{color.neutral.200}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.1000}"
          }
        },
        "$description": "One step below the page: wells, tracks, skeletons, a segmented control's groove."
      },
      "inverse": {
        "$value": "{color.neutral.950}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.100}"
          }
        },
        "$description": "The opposite of the page: tooltips, and anything that must stand out from every surface."
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.950}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.100}"
          }
        },
        "$description": "Body text and anything that must read at full strength on a surface."
      },
      "muted": {
        "$value": "{color.neutral.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.400}"
          }
        },
        "$description": "Secondary text and icons: hints, values beside a label, chevrons."
      },
      "faint": {
        "$value": "{color.neutral.600}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.450}"
          }
        },
        "$description": "Lowest-emphasis text. Promised AA on base and raised surfaces only, not on sunken."
      },
      "on-action": {
        "$value": "{color.neutral.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}",
            "note": "Dark scheme fills are light, so the text flips to ink."
          }
        },
        "$description": "Text and marks on an action fill (action.primary and its states). Each brand picks whichever of light or ink meets AA on its fill."
      },
      "on-inverse": {
        "$value": "{color.neutral.50}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        },
        "$description": "Text on surface.inverse: tooltips, an inverted selected chip."
      }
    },
    "action": {
      "primary": {
        "$value": "{color.ultramarine.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.300}"
          }
        },
        "$description": "The fill of the main action and of chosen state: primary Button, checked controls, selected options, slider fill, tab indicator."
      },
      "primary-hover": {
        "$value": "{color.ultramarine.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.200}"
          }
        },
        "$description": "action.primary under the pointer."
      },
      "primary-active": {
        "$value": "{color.ultramarine.800}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.400}"
          }
        },
        "$description": "action.primary while pressed."
      },
      "primary-quiet": {
        "$value": "{color.ultramarine.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.900}"
          }
        },
        "$description": "A faint tint of the action colour for backgrounds: ghost hover, subtle action Badge, an unselected action Chip, a highlighted option."
      },
      "secondary": {
        "$value": "{color.neutral.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.850}"
          }
        },
        "$description": "The fill of a secondary action: secondary Button, neutral Chip, a dialog's close button."
      },
      "secondary-hover": {
        "$value": "{color.neutral.200}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.800}"
          }
        },
        "$description": "action.secondary under the pointer."
      },
      "text": {
        "$value": "{color.ultramarine.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.300}"
          }
        },
        "$description": "Accent for text and icons sitting on a surface (links, ghost buttons). Meets AA on every surface; action.primary is a fill and need not."
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.300}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.850}"
          }
        },
        "$description": "Edges and dividers that separate without asking for attention: cards, fields at rest, table rules."
      },
      "strong": {
        "$value": "{color.neutral.400}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.800}"
          }
        },
        "$description": "An edge that must be seen: a hovered field, the box of a checkbox or radio."
      },
      "focus": {
        "$value": "{color.ultramarine.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.300}"
          }
        },
        "$description": "The focus ring, and nothing else. Every component's focus ring reads it, so focus looks the same everywhere."
      }
    },
    "status": {
      "success": {
        "$value": "{color.green.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.green.300}"
          }
        },
        "$description": "The solid success fill: solid Badge, progress indicator, Alert accent bar. Pair with status.on-success."
      },
      "warning": {
        "$value": "{color.saffron.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.saffron.500}"
          }
        },
        "$description": "The solid warning fill: solid Badge, progress indicator, Alert accent bar. Pair with status.on-warning."
      },
      "error": {
        "$value": "{color.red.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.red.300}"
          }
        },
        "$description": "The solid error fill and the invalid field's border: danger Button, solid Badge, Alert accent bar. Pair with status.on-error."
      },
      "error-hover": {
        "$value": "{color.red.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.red.200}"
          }
        },
        "$description": "A filled error surface under the pointer (a danger Button). Darkens in light, lightens in dark: away from its on-error text."
      },
      "error-active": {
        "$value": "{color.red.800}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.red.400}"
          }
        },
        "$description": "A filled error surface while pressed."
      },
      "info": {
        "$value": "{color.ultramarine.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.300}"
          }
        },
        "$description": "The solid info fill: solid Badge, Alert accent bar. Pair with status.on-info."
      },
      "error-text": {
        "$value": "{color.red.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.red.300}"
          }
        },
        "$description": "Error colour for text (messages, required markers). status.error is a fill/border colour and is below AA as text on light surfaces."
      },
      "success-text": {
        "$value": "{color.green.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.green.300}"
          }
        },
        "$description": "Success colour for text and icons on a surface, and for the edge of a subtle success Badge."
      },
      "warning-text": {
        "$value": "{color.saffron.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.saffron.500}"
          }
        },
        "$description": "Warning colour for text and icons on a surface, and for the edge of a subtle warning Badge."
      },
      "info-text": {
        "$value": "{color.ultramarine.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.300}"
          }
        },
        "$description": "Info colour for text and icons on a surface, and for the edge of a subtle info Badge."
      },
      "success-subtle": {
        "$value": "{color.green.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.green.900}"
          }
        },
        "$description": "Tinted background for the success tone; pair with success-text."
      },
      "warning-subtle": {
        "$value": "{color.saffron.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.saffron.900}"
          }
        },
        "$description": "Tinted background for the warning tone; pair with warning-text."
      },
      "error-subtle": {
        "$value": "{color.red.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.red.900}"
          }
        },
        "$description": "Tinted background for the error tone; pair with error-text."
      },
      "info-subtle": {
        "$value": "{color.ultramarine.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.900}"
          }
        },
        "$description": "Tinted background for the info tone; pair with info-text."
      },
      "on-success": {
        "$value": "{color.neutral.950}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}",
            "note": "Ink: bone on this green is 3.5:1."
          }
        },
        "$description": "Text on the solid success fill. Each brand picks whichever of light or ink meets AA on its green."
      },
      "on-warning": {
        "$value": "{color.neutral.950}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        },
        "$description": "Text on the solid warning fill."
      },
      "on-error": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}",
            "note": "White on the light red fill, ink on the light-scheme-dark fill."
          }
        },
        "$description": "Text on the solid error fill. Each brand picks whichever of light or ink meets AA on it, per scheme."
      },
      "on-info": {
        "$value": "{color.neutral.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        },
        "$description": "Text on the solid info fill."
      },
      "neutral": {
        "$value": "{color.neutral.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.400}"
          }
        },
        "$description": "A tone with no meaning: default Badge, counts, tags."
      },
      "neutral-subtle": {
        "$value": "{color.neutral.100}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.850}"
          }
        },
        "$description": "Tinted background for the neutral tone: subtle Badge, the default Avatar."
      },
      "neutral-text": {
        "$value": "{color.neutral.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.400}"
          }
        },
        "$description": "Neutral tone colour for text on a surface or on neutral-subtle."
      },
      "on-neutral": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        },
        "$description": "Text on the solid neutral fill."
      }
    },
    "accent": {
      "1": {
        "$value": "{color.ultramarine.500}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.ultramarine.300}"
          }
        }
      },
      "2": {
        "$value": "{color.orange.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.orange.300}"
          }
        }
      },
      "3": {
        "$value": "{color.green.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.green.300}"
          }
        }
      },
      "4": {
        "$value": "{color.violet.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.violet.300}"
          }
        }
      },
      "5": {
        "$value": "{color.red.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.red.300}"
          }
        }
      },
      "6": {
        "$value": "{color.teal.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.teal.300}"
          }
        }
      },
      "7": {
        "$value": "{color.saffron.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.saffron.500}"
          }
        }
      },
      "8": {
        "$value": "{color.pink.700}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.pink.300}"
          }
        }
      },
      "$description": "Eight categorical fills for telling things of one kind apart (people, mostly): a consumer hashes an id to an index. No meaning is attached to a number; the hues come in the same order in every brand (blue, orange, green, violet, red, teal, amber, pink). Pair accent.N with accent.on-N, never with another text colour.",
      "on-1": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-2": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-3": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-4": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-5": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-6": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-7": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      },
      "on-8": {
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "{color.neutral.950}"
          }
        }
      }
    },
    "data": {
      "$description": "Fills for data, not for UI. sequential.0 is \"none\" and 1-4 rise in intensity, on the brand's own hue: a heatmap's cells, a density scale. In dark schemes the ramp inverts, so more is always brighter against the surface. Never carries text.",
      "sequential": {
        "0": {
          "$value": "{color.neutral.100}",
          "$extensions": {
            "com.pearpages.pulp": {
              "dark": "{color.neutral.850}"
            }
          },
          "$description": "Zero: one step off the raised surface, so an empty cell still reads as a slot."
        },
        "1": {
          "$value": "{color.ultramarine.200}",
          "$extensions": {
            "com.pearpages.pulp": {
              "dark": "{color.ultramarine.800}"
            }
          }
        },
        "2": {
          "$value": "{color.ultramarine.400}",
          "$extensions": {
            "com.pearpages.pulp": {
              "dark": "{color.ultramarine.500}"
            }
          }
        },
        "3": {
          "$value": "{color.ultramarine.500}",
          "$extensions": {
            "com.pearpages.pulp": {
              "dark": "{color.ultramarine.400}"
            }
          }
        },
        "4": {
          "$value": "{color.ultramarine.800}",
          "$extensions": {
            "com.pearpages.pulp": {
              "dark": "{color.ultramarine.200}"
            }
          }
        }
      }
    },
    "overlay": {
      "backdrop": {
        "$value": "#0c0e1499",
        "$extensions": {
          "com.pearpages.pulp": {
            "dark": "#000000b3"
          }
        },
        "$description": "Scrim behind dialogs and sheets. Alpha hex, no primitive: it is a role, not a palette colour."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": "{typeface.display}",
        "$description": "Headings and display text."
      },
      "body": {
        "$value": "{typeface.body}",
        "$description": "Running text and every control."
      },
      "mono": {
        "$value": "{typeface.mono}",
        "$description": "Code, keyboard input, samples."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.375,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.75,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "$description": "Type scale, xs to 3xl. Body text is md; the steps above it are for headings."
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "Running text."
      },
      "medium": {
        "$value": 500,
        "$description": "Labels and controls: buttons, tabs, chips."
      },
      "semibold": {
        "$value": 600,
        "$description": "Headings and the strongest emphasis in a control."
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2,
        "$description": "Headings and single-line controls, where the box, not the leading, sets the height."
      },
      "normal": {
        "$value": 1.5,
        "$description": "Running text."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.sm}",
      "$description": "Buttons, inputs, chips."
    },
    "surface": {
      "$value": "{radius.lg}",
      "$description": "Cards, dialogs, popovers."
    },
    "full": {
      "$value": "{radius.pill}",
      "$description": "Fully round: pills and circles (avatars, switch tracks, a brand's pill buttons)."
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 1
        }
      }
    },
    "2": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 2
        }
      }
    },
    "3": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 3
        }
      }
    },
    "4": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 4
        }
      }
    },
    "5": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 6
        }
      }
    },
    "6": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 8
        }
      }
    },
    "7": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 12
        }
      }
    },
    "8": {
      "$value": "{space.unit}",
      "$extensions": {
        "com.pearpages.pulp": {
          "multiply": 16
        }
      }
    },
    "$description": "Spacing scale. Names are steps, not multipliers: 1..8 map to 1, 2, 3, 4, 6, 8, 12, 16 \u00d7 space.unit, so the scale opens up at the top like a type scale. space.unit is the density knob for the brand."
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.fast}",
        "$description": "Feedback on something already on screen: hover, press, focus, a toggle."
      },
      "base": {
        "$value": "{duration.base}",
        "$description": "Something entering or leaving: an overlay opening, a panel expanding."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}",
        "$description": "The easing of every transition, so motion reads as one system."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "color": "#0c0e141a"
      },
      "$extensions": {
        "com.pearpages.pulp": {
          "dark": {
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 2,
              "unit": "px"
            },
            "blur": {
              "value": 12,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            },
            "color": "#00000059"
          }
        }
      },
      "$description": "Resting elevation for something that sits on the page: a card."
    },
    "overlay": {
      "$value": {
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 16,
          "unit": "px"
