{
  "$description": "Popover component tokens.",
  "popover": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "fg": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "width": {
      "$type": "dimension",
      "$value": "{size.popover-width}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.overlay}"
    },
    "layer": {
      "$type": "number",
      "$value": "{layer.popover}"
    },
    "duration": {
      "$type": "duration",
      "$value": "{motion.duration.fast}"
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "ring-width": {
        "$type": "dimension",
        "$value": "{focus.ring.width}"
      },
      "ring-offset": {
        "$type": "dimension",
        "$value": "{focus.ring.offset}"
      }
    }
  }
}
