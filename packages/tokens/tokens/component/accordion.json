{
  "$description": "Accordion component tokens.",
  "accordion": {
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "trigger": {
      "padding-block": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.size.md}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.text.default}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.action.primary-quiet}"
      },
      "chevron": {
        "$type": "color",
        "$value": "{color.text.muted}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.3}"
      }
    },
    "panel": {
      "padding-block": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.text.default}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.size.sm}"
      }
    },
    "duration": {
      "$type": "duration",
      "$value": "{motion.duration.fast}"
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "ring-width": {
        "$type": "dimension",
        "$value": "{focus.ring.width}"
      },
      "ring-offset": {
        "$type": "dimension",
        "$value": "{focus.ring.offset}"
      }
    }
  }
}
