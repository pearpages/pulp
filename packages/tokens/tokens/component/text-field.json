{
  "$description": "TextField component tokens. Brand-independent: every value references the semantic layer.",
  "text-field": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.body}"
      },
      "size": {
        "$type": "dimension",
        "sm": {
          "$value": "{font.size.sm}"
        },
        "md": {
          "$value": "{font.size.md}"
        },
        "lg": {
          "$value": "{font.size.lg}"
        }
      }
    },
    "height": {
      "$type": "dimension",
      "sm": {
        "$value": "{size.control.sm}"
      },
      "md": {
        "$value": "{size.control.md}"
      },
      "lg": {
        "$value": "{size.control.lg}"
      }
    },
    "bg": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "fg": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.text.faint}"
    },
    "border": {
      "$type": "color",
      "default": {
        "$value": "{color.border.default}"
      },
      "hover": {
        "$value": "{color.border.strong}"
      },
      "focus": {
        "$value": "{color.border.focus}"
      },
      "invalid": {
        "$value": "{color.status.error}"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "ring-width": {
        "$type": "dimension",
        "$value": "{focus.ring.width}"
      },
      "ring-offset": {
        "$type": "dimension",
        "$value": "{focus.ring.offset}"
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "$value": "{motion.duration.fast}"
      }
    },
    "icon": {
      "fg": {
        "$type": "color",
        "$description": "The leading glyph and the clear button at rest.",
        "$value": "{color.text.muted}"
      },
      "fg-hover": {
        "$type": "color",
        "$value": "{color.text.default}"
      },
      "gap": {
        "$type": "dimension",
        "$description": "Between the glyph and the text.",
        "$value": "{space.2}"
      }
    }
  }
}
