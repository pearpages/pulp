{
  "$description": "NavList component tokens. Reference the semantic layer only.",
  "nav-list": {
    "gap": { "$type": "dimension", "$description": "Between the links of one list.", "$value": "{space.1}" },
    "item": {
      "min-height": { "$type": "dimension", "$value": "{size.control.md}" },
      "padding-inline": { "$type": "dimension", "$value": "{space.3}" },
      "gap": { "$type": "dimension", "$description": "Between the icon, the label and the badge.", "$value": "{space.3}" },
      "radius": { "$type": "dimension", "$value": "{radius.control}" },
      "font-size": { "$type": "dimension", "$value": "{font.size.sm}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
      "fg": { "$type": "color", "$value": "{color.text.muted}" },
      "fg-hover": { "$type": "color", "$value": "{color.text.default}" },
      "bg-hover": { "$type": "color", "$value": "{color.surface.sunken}" },
      "current-bg": { "$type": "color", "$description": "The link to the page being shown.", "$value": "{color.action.primary-quiet}" },
      "current-fg": { "$type": "color", "$value": "{color.action.text}" },
      "current-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "section-fg": { "$type": "color", "$description": "A section link while one of its sub-pages is shown: coloured, not filled, so the page itself stays the one marked.", "$value": "{color.action.text}" }
    },
    "icon-size": { "$type": "dimension", "$description": "Icons are drawn at 1em, so this is their size.", "$value": "{font.size.lg}" },
    "sub": {
      "indent": { "$type": "dimension", "$description": "How far a sub-list sits in from its section's link: past the section's icon.", "$value": "{space.6}" },
      "padding-block": { "$type": "dimension", "$value": "{space.1}" },
      "divider": { "$type": "color", "$description": "The line down the start edge of a sub-list.", "$value": "{color.border.default}" },
      "divider-width": { "$type": "dimension", "$value": "{size.hairline}" }
    },
    "focus-ring": { "$type": "color", "$value": "{color.border.focus}" },
    "focus-ring-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-ring-offset": { "$type": "dimension", "$value": "{focus.ring.offset}" },
    "duration": { "$type": "duration", "$value": "{motion.duration.fast}" }
  }
}
