  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "unit": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "The density knob. Every semantic space token is a multiple of this."
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 140,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 260,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0.7,
        0.3,
        1
      ]
    }
  },
  "typeface": {
    "display": {
      "$value": [
        "Archivo Variable",
        "Archivo",
        "system-ui",
        "sans-serif"
      ]
    },
    "body": {
      "$value": [
        "Instrument Sans Variable",
