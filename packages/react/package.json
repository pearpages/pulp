{
  "name": "@pearpages/pulp-react",
  "version": "0.0.0",
  "description": "pulp React components. Accessible, token-driven, CSS modules, one entry per component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearpages/pulp.git",
    "directory": "packages/react"
  },
  "homepage": "https://pulp.pearpages.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./visually-hidden": {
      "types": "./dist/visually-hidden.d.ts",
      "import": "./dist/visually-hidden.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./heading": {
      "types": "./dist/heading.d.ts",
      "import": "./dist/heading.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./text-field": {
      "types": "./dist/text-field.d.ts",
      "import": "./dist/text-field.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./styles.css": "./dist/index.css",
    "./field.css": "./dist/field.css",
    "./inline.css": "./dist/inline.css",
    "./stack.css": "./dist/stack.css",
    "./visually-hidden.css": "./dist/visually-hidden.css",
    "./icon.css": "./dist/icon.css",
    "./heading.css": "./dist/heading.css",
    "./text.css": "./dist/text.css",
    "./dialog.css": "./dist/dialog.css",
    "./tabs.css": "./dist/tabs.css",
    "./card.css": "./dist/card.css",
    "./text-field.css": "./dist/text-field.css",
    "./button.css": "./dist/button.css",
    "./component-manifest.json": "./dist/component-manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/manifest.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "manifest": "node scripts/manifest.mjs",
    "scaffold": "node scripts/scaffold-component.mjs",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css button.css text-field.css card.css tabs.css dialog.css text.css heading.css icon.css visually-hidden.css stack.css inline.css field.css component-manifest.json",
    "prepublishOnly": "pnpm run build && pnpm run test:run && pnpm run check:package"
  },
  "peerDependencies": {
    "@pearpages/pulp-tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@pearpages/pulp-icons": "workspace:*",
    "@pearpages/pulp-tokens": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@pearpages/pulp-tokens": {
      "optional": false
    }
  },
  "dependencies": {
    "@pearpages/modals": "^0.2.0"
  }
}
