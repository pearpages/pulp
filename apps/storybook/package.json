{
  "name": "pulp-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fonts.mjs && pnpm --filter @pearpages/pulp-react manifest && storybook dev -p 6006",
    "build": "node scripts/fonts.mjs && pnpm --filter @pearpages/pulp-react manifest && storybook build && node scripts/check-links.mjs",
    "test": "vitest",
    "test:site": "node scripts/check-built-site.mjs && playwright test",
    "test:visual:update": "PULP_VISUAL=1 playwright test --update-snapshots",
    "og-card": "node scripts/og-card.mjs",
    "test:run": "pnpm --filter @pearpages/pulp-react manifest && vitest run",
    "typecheck": "pnpm --filter @pearpages/pulp-react manifest && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@pearpages/pulp-css": "workspace:*",
    "@pearpages/pulp-react": "workspace:*",
    "@pearpages/pulp-tokens": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pearpages/heatmap": "^0.4.1",
    "@pearpages/modals": "^0.4.0",
    "@pearpages/pulp-icons": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "4.13.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
